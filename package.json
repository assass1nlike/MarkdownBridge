{
  "name": "markdown-bridge",
  "version": "0.7.3",
  "description": "面向 B 站、抖音和小红书的 Markdown 转换、图文渲染与发布工具",
  "homepage": "https://github.com/assass1nlike/MarkdownBridge",
  "repository": {
    "type": "git",
    "url": "https://github.com/assass1nlike/MarkdownBridge.git"
  },
  "bugs": {
    "url": "https://github.com/assass1nlike/MarkdownBridge/issues"
  },
  "private": true,
  "scripts": {
    "build": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack",
    "build:douyin": "cross-env NODE_OPTIONS=--openssl-legacy-provider NODE_ENV=production webpack --config webpack.douyin.config.ts",
    "build:all": "npm run build && npm run build:douyin",
    "render:douyin": "node tools/render-douyin-images.js",
    "xhs": "node tools/xiaohongshu.js",
    "test:xhs": "node --test test/xiaohongshu.test.js",
    "test:render": "node --test test/render-math.test.js",
    "debug": "cross-env NODE_ENV=development webpack -w",
    "test": "ts-node --files test/reverse.test.ts && ts-node --files test/opus.test.ts && ts-node --files test/heading.test.ts && ts-node --files test/latex.test.ts && ts-node --files test/douyin.test.ts"
  },
  "keywords": [
    "bilibili",
    "markdown",
    "article",
    "latex",
    "tampermonkey",
    "userscript"
  ],
  "author": "Passkou and contributors",
  "license": "MIT",
  "devDependencies": {
    "@types/crypto-js": "^4.0.1",
    "@types/js-cookie": "^3.0.6",
    "@types/marked": "^1.2.2",
    "@types/mime": "^2.0.3",
    "@types/node": "^14.14.25",
    "@types/prismjs": "^1.16.2",
    "@types/tampermonkey": "^4.0.0",
    "@types/terser-webpack-plugin": "^5.0.2",
    "@types/turndown": "^5.0.6",
    "cross-env": "^7.0.3",
    "katex": "^0.16.11",
    "mathjax": "4.1.3",
    "playwright": "^1.61.1",
    "terser-webpack-plugin": "^5.1.1",
    "ts-loader": "^8.0.15",
    "ts-node": "^9.1.1",
    "typescript": "^4.1.6",
    "webpack": "^5.20.2",
    "webpack-cli": "^4.5.0",
    "webpack-userscript": "^2.5.6"
  },
  "dependencies": {
    "canvas-table": "^0.3.0",
    "crypto-js": "^4.0.0",
    "js-cookie": "^2.2.1",
    "marked": "^1.2.9",
    "mime": "^2.5.0",
    "prismjs": "^1.23.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
